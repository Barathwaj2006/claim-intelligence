{
  "name": "claim-intelligence",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web && mkdir -p dist && cp -r apps/web/dist/* dist/",
    "lint": "npm run lint --workspace=apps/web"
  }
}
