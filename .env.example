# =============================================================================
# U.S. Healthcare Claim Intelligence Platform - Environment Configuration
# =============================================================================

# Database Connection (SQLite default for local dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./claim_intelligence.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/claim_intelligence

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Log Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO